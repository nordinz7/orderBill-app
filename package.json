{
  "name": "orderbill",
  "main": "expo-router/entry",
  "version": "1.0.3",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "eas build --platform android --profile preview --local",
    "build:aab": "eas build --platform android --profile production",
    "submit": "eas submit --platform android --profile production",
    "version:patch": "npm version patch --no-git-tag-version && node -e \"const a=require('./app.json');a.expo.version=require('./package.json').version;require('fs').writeFileSync('./app.json',JSON.stringify(a,null,2)+'\\n')\"",
    "version:minor": "npm version minor --no-git-tag-version && node -e \"const a=require('./app.json');a.expo.version=require('./package.json').version;require('fs').writeFileSync('./app.json',JSON.stringify(a,null,2)+'\\n')\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "bun@1.4.2",
  "private": true
}